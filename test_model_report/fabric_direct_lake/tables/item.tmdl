/// Product dimension containing item details such as brand, category, class, color, pricing, and manufacturing information.
table item
	lineageTag: 0f958ae1-af31-4b29-87a3-7e9ee589887e
	sourceLineageTag: [dbo].[item]

	/// Item surrogate key - unique identifier for each product.
	column i_item_sk
		dataType: int64
		formatString: 0
		lineageTag: 23893369-a589-4284-afa3-b1e291864600
		sourceLineageTag: i_item_sk
		summarizeBy: none
		sourceColumn: i_item_sk

		annotation SummarizationSetBy = Automatic

	/// Current retail price of the product.
	column i_current_price
